<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>RA2</string>
	<key>CFBundleIconFile</key>
	<string>RA2</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.ra2native.RA2</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Red Alert 2</string>
	<key>CFBundleDisplayName</key>
	<string>Red Alert 2</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MINOS@</string>
	<key>LSArchitecturePriority</key>
	<array>
		<string>arm64</string>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.strategy-games</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Native rebuild for local use. Game data is read from your own installation and is not included.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Red Alert 2 reads the game's files from your installed game folder.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Red Alert 2 reads the game's files from your installed game folder.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Red Alert 2 reads the game's files from your installed game folder.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Red Alert 2 reads the game's files from your installed game folder.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Red Alert 2 reads the game's files from your installed game folder.</string>
</dict>
</plist>
